# ModelDock local development configuration.
# Copy to .env and replace every replace-with-* value before production.

NODE_ENV=development
MODELDOCK_BIND_HOST=127.0.0.1

PUBLIC_SITE_URL=http://127.0.0.1:3000
PUBLIC_APP_URL=http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:3002
ADMIN_APP_URL=http://127.0.0.1:3001
TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001

DATABASE_URL=postgresql://modeldock:replace-with-local-db-password@postgres:5432/modeldock
POSTGRES_USER=modeldock
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_DB=modeldock

SESSION_SECRET=replace-with-strong-random-session-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-strong-random-32-byte-key
CREDENTIAL_ENCRYPTION_KEY_ID=default-v1
OWNER_BOOTSTRAP_TOKEN=replace-with-one-time-local-bootstrap-token

LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=replace-with-strong-litellm-master-key
LITELLM_CONFIG_PATH=/app/config.yaml
LITELLM_VERSION=v1.57.8

PUBLIC_REGISTRATION_ENABLED=false
ADMIN_BOOTSTRAP_ENABLED=false
LOG_CHAT_CONTENT=false

DEFAULT_USER_CREDITS_USD=5
DEFAULT_BUDGET_DURATION=30d

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

EXPERIMENTAL_SUBSCRIPTION_OAUTH=false
EXPERIMENTAL_CHATGPT_SUBSCRIPTION=false
EXPERIMENTAL_CLAUDE_SUBSCRIPTION=false
